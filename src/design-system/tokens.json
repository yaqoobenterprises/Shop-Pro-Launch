{
  "name": "Shop Pro",
  "version": "2.0.0",
  "status": "Implemented SaaS component system",
  "font": {
    "family": "Manrope",
    "weights": [
      400,
      600,
      700
    ],
    "fallback": "Segoe UI, Arial, sans-serif",
    "numbers": "lining-nums tabular-nums"
  },
  "fontSize": {
    "caption": 12,
    "meta": 13,
    "label": 14,
    "body": 16,
    "section": 18,
    "title": 24,
    "page": 28,
    "money": 32,
    "display": 48
  },
  "lineHeight": {
    "body": 1.55,
    "label": 1.4,
    "heading": 1.2,
    "money": 1.15
  },
  "spacing": [
    0,
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
  ],
  "radius": {
    "small": 4,
    "control": 6,
    "panel": 10,
    "dialog": 12
  },
  "controlHeight": {
    "small": 36,
    "default": 44,
    "large": 48
  },
  "icon": {
    "family": "Lucide",
    "viewBox": "0 0 24 24",
    "sizes": [
      16,
      20,
      24
    ],
    "strokeWidth": 1.75
  },
  "motion": {
    "fast": 120,
    "normal": 180,
    "easing": "cubic-bezier(.2,.8,.2,1)",
    "reducedMotion": true
  },
  "chart": {
    "height": 280,
    "mobileHeight": 230,
    "lineWidth": 2.5,
    "pointRadius": 3,
    "ringRadius": 70,
    "ringStroke": 24,
    "minimumLabelSize": 11,
    "maxDonutCategories": 6,
    "engine": "Apache ECharts"
  },
  "themes": {
    "light": {
      "canvas": "#f7f8fa",
      "surface": "#ffffff",
      "surface-raised": "#ffffff",
      "surface-subtle": "#eff2f6",
      "surface-selected": "#eaf0ff",
      "text": "#17232f",
      "text-secondary": "#566171",
      "text-inverse": "#ffffff",
      "border": "#e3e7ee",
      "border-strong": "#a2adbc",
      "primary": "#315ac8",
      "primary-hover": "#274aa8",
      "primary-pressed": "#1d3c8e",
      "on-primary": "#ffffff",
      "focus": "#315ac8",
      "income": "#146b51",
      "income-subtle": "#e7f4ee",
      "expense": "#a94635",
      "expense-subtle": "#faede8",
      "warning": "#7d5c16",
      "warning-subtle": "#fff3da",
      "disabled-bg": "#e8edf3",
      "disabled-text": "#6d7c90",
      "overlay": "#17243899",
      "chart-income": "#147567",
      "chart-expense": "#b35436",
      "chart-result": "#315ac8",
      "chart-1": "#315ac8",
      "chart-2": "#157b79",
      "chart-3": "#9d6221",
      "chart-4": "#865ca1",
      "chart-5": "#61718c",
      "chart-6": "#ab4d76",
      "chart-grid": "#e4e9f0",
      "chart-zero": "#8190a4"
    },
    "dark": {
      "canvas": "#11151c",
      "surface": "#181e28",
      "surface-raised": "#202836",
      "surface-subtle": "#222f3f",
      "surface-selected": "#243c68",
      "text": "#edf2f8",
      "text-secondary": "#aebacc",
      "text-inverse": "#162130",
      "border": "#303a49",
      "border-strong": "#8294ab",
      "primary": "#a5bfff",
      "primary-hover": "#c0d1ff",
      "primary-pressed": "#8eacf2",
      "on-primary": "#162544",
      "focus": "#a5bfff",
      "income": "#81d6b4",
      "income-subtle": "#1d3d34",
      "expense": "#f0a591",
      "expense-subtle": "#47302c",
      "warning": "#e6c37c",
      "warning-subtle": "#403725",
      "disabled-bg": "#293545",
      "disabled-text": "#a3afc0",
      "overlay": "#060c15bf",
      "chart-income": "#81d6b4",
      "chart-expense": "#f0a591",
      "chart-result": "#a5bfff",
      "chart-1": "#a5bfff",
      "chart-2": "#68c9c4",
      "chart-3": "#e3b375",
      "chart-4": "#c5a6e2",
      "chart-5": "#a6b6d0",
      "chart-6": "#eda4c1",
      "chart-grid": "#2f4054",
      "chart-zero": "#8294ab"
    }
  },
  "palette": {
    "brand": {
      "50": "#eaf0ff",
      "100": "#dce6ff",
      "200": "#c0d1ff",
      "300": "#a5bfff",
      "400": "#8eacf2",
      "500": "#557adc",
      "600": "#315ac8",
      "700": "#274aa8",
      "800": "#1d3c8e",
      "900": "#162544"
    },
    "neutral": {
      "0": "#ffffff",
      "50": "#f4f6f9",
      "100": "#edf1f6",
      "200": "#dce3ec",
      "300": "#bdc8d7",
      "400": "#8190a4",
      "500": "#6d7c90",
      "600": "#56677c",
      "700": "#344457",
      "800": "#233142",
      "900": "#19232f",
      "950": "#111820"
    }
  },
  "breakpoints": {
    "mobile": 320,
    "tablet": 768,
    "laptop": 1000,
    "desktop": 1200,
    "wide": 1800
  },
  "shadow": {
    "card": "none",
    "popover": "0 4px 16px var(--sp-overlay)",
    "dialog": "0 16px 60px var(--sp-overlay)"
  }
}
