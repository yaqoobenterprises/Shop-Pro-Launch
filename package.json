{
  "name": "shop-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist', {recursive:true, force:true})\"",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:size": "node scripts/check_file_sizes.mjs",
    "check:strict": "tsc -p tsconfig.strict.json --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "5.3.0",
    "@supabase/supabase-js": "^2.49.1",
    "@tailwindcss/vite": "^4.0.9",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss": "^4.0.9",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "^26.0.0",
    "supabase": "2.121.0",
    "tsx": "4.20.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^4.1.11"
  }
}
