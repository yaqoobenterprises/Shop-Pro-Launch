VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Staging/preview only: enable the owner company setup wizard after auth/RLS review.
VITE_ENABLE_COMPANY_SETUP_WIZARD=false

# REVIEW builds ONLY. Existing live company accounts must open their real ledger.
# Production build refuses "true"; the example ERP remains a separate menu route.
VITE_AQVORA_PREVIEW_DEFAULT=false

# Safe V2 finance defaults: NEVER use these with real business companies.
# All VITE_ENABLE_AQVORA_* feature flags are OFF unless a separately
# authorized disposable synthetic staging environment is approved.
# AQVORA_RELEASE_TARGET=production  # Self-hosted production build gate
